<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="myarm_m750">
  <!--
    Canonical MyArm M750 kinematic model v3.2.

    q_ros is shared by core, TF, Pinocchio, MoveIt, and visualization. Firmware
    calibration offsets are adapter-only and must never be embedded here.
    Arm joint origins have zero RPY and axes +Z, +Y, +Y, +X, +Y, +X.

    model_variant:
      full        original detailed visual meshes, primitive collision
      lightweight primitive visual and collision geometry
      kinematic   links and joints only, without geometry

    No inertial data are published because mass, center-of-mass, inertia, and
    payload provenance are not yet certified. Velocity and effort are
    provisional planning limits, not manufacturer safety limits.
  -->

  <xacro:arg name="model_variant" default="full"/>
  <xacro:property name="variant" value="$(arg model_variant)"/>

  <xacro:macro
    name="model_link"
    params="name mesh mesh_xyz mesh_rpy primitive_xyz primitive_rpy primitive_size">
    <link name="${name}">
      <xacro:unless value="${variant == 'kinematic'}">
        <visual name="${name}_visual">
          <xacro:if value="${variant == 'full'}">
            <origin xyz="${mesh_xyz}" rpy="${mesh_rpy}"/>
            <geometry>
              <mesh
                filename="package://myarm_m750_description/meshes/visual/${mesh}"
                scale="1 1 1"/>
            </geometry>
          </xacro:if>
          <xacro:unless value="${variant == 'full'}">
            <origin xyz="${primitive_xyz}" rpy="${primitive_rpy}"/>
            <geometry>
              <box size="${primitive_size}"/>
            </geometry>
          </xacro:unless>
        </visual>
        <collision name="${name}_collision">
          <origin xyz="${primitive_xyz}" rpy="${primitive_rpy}"/>
          <geometry>
            <box size="${primitive_size}"/>
          </geometry>
        </collision>
      </xacro:unless>
    </link>
  </xacro:macro>

  <!-- Visual mesh transforms are preserved from the supplied v3.2 URDF.
       Primitive collision is approximate/provisional pending physical review. -->
  <xacro:model_link
    name="base_link" mesh="base_link.dae"
    mesh_xyz="0 0 0" mesh_rpy="0 0 0"
    primitive_xyz="0 0 0.05" primitive_rpy="0 0 0"
    primitive_size="0.18 0.18 0.10"/>
  <xacro:model_link
    name="shoulder_link" mesh="shoulder_link.dae"
    mesh_xyz="0 0 0" mesh_rpy="0 0 0"
    primitive_xyz="0 0 0.035" primitive_rpy="0 0 0"
    primitive_size="0.14 0.14 0.14"/>
  <xacro:model_link
    name="upper_arm_link" mesh="upper_arm_link.dae"
    mesh_xyz="0 0 0" mesh_rpy="1.570796326794897 -1.570796326794897 0"
    primitive_xyz="0.0285 0 0.1515" primitive_rpy="0 0 0"
    primitive_size="0.10 0.10 0.33"/>
  <xacro:model_link
    name="lower_arm_link" mesh="lower_arm_link.dae"
    mesh_xyz="0 0 0" mesh_rpy="-1.570796326794897 0 0"
    primitive_xyz="0.0394 0 0" primitive_rpy="0 0 0"
    primitive_size="0.13 0.09 0.09"/>
  <xacro:model_link
    name="forearm_link" mesh="forearm_link.dae"
    mesh_xyz="-0.009 0 0" mesh_rpy="-3.141592653589793 -1.570796326794897 0"
    primitive_xyz="0.124555 0 0" primitive_rpy="0 0 0"
    primitive_size="0.27 0.08 0.08"/>
  <xacro:model_link
    name="wrist_link" mesh="wrist_link.dae"
    mesh_xyz="0 0 0" mesh_rpy="-1.570796326794897 0 0"
    primitive_xyz="0.0395 0 0" primitive_rpy="0 0 0"
    primitive_size="0.11 0.08 0.08"/>
  <link name="flange_link"/>
  <link name="tool0"/>
  <xacro:model_link
    name="gripper_base_link" mesh="gripper_base_link.dae"
    mesh_xyz="0 0 -0.0427" mesh_rpy="0 0 0"
    primitive_xyz="0 0 -0.035" primitive_rpy="0 0 0"
    primitive_size="0.09 0.10 0.09"/>
  <xacro:model_link
    name="left_gripper_link" mesh="left_gripper_link.dae"
    mesh_xyz="0 -0.0079 0" mesh_rpy="0 3.141592653589793 -1.570796326794897"
    primitive_xyz="0 0 0.035" primitive_rpy="0 0 0"
    primitive_size="0.025 0.025 0.10"/>
  <xacro:model_link
    name="right_gripper_link" mesh="right_gripper_link.dae"
    mesh_xyz="0 -0.0079 0" mesh_rpy="0 3.141592653589793 -1.570796326794897"
    primitive_xyz="0 0 -0.035" primitive_rpy="0 0 0"
    primitive_size="0.025 0.025 0.10"/>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.097900" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.879793265790644" upper="2.879793265790644" velocity="1.0" effort="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.076000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796326794897" upper="1.570796326794897" velocity="1.0" effort="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="elbow_flex_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <origin xyz="0.057000 0 0.303000" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796326794897" upper="1.570796326794897" velocity="1.0" effort="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="forearm_roll_joint" type="revolute">
    <parent link="lower_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.078800 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.792526803190927" upper="2.792526803190927" velocity="1.0" effort="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="wrist_flex_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.249110 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.570796326794897" upper="2.0943951023931953" velocity="1.0" effort="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="flange_link"/>
    <origin xyz="0.079000 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" velocity="1.0" effort="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- tool0 is +118 mm along flange +X with a -pi/2 pitch. -->
  <joint name="flange_to_tool0_joint" type="fixed">
    <parent link="flange_link"/>
    <child link="tool0"/>
    <origin xyz="0.118000 0 0" rpy="0 -1.570796326794897 0"/>
  </joint>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="flange_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0.031000 0 0" rpy="0 1.570796326794897 0"/>
  </joint>

  <joint name="left_gripper_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_gripper_link"/>
    <origin xyz="0 0.008000 0" rpy="1.570796326794897 0 -3.141592653589793"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.0345" velocity="0.05" effort="20.0"/>
  </joint>

  <joint name="right_gripper_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_gripper_link"/>
    <origin xyz="0 -0.008000 0" rpy="1.570796326794897 0 -3.141592653589793"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.0" upper="0.0345" velocity="0.05" effort="20.0"/>
    <mimic joint="left_gripper_joint" multiplier="1.0" offset="0.0"/>
  </joint>
</robot>
